<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="200" height="200">
  <defs>
    <linearGradient id="grad_capsule_jpg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#dc2626" stop-opacity="0.08" />
      <stop offset="100%" stop-color="#991b1b" stop-opacity="0.15" />
    </linearGradient>
    <filter id="shadow_capsule_jpg">
      <feDropShadow dx="0" dy="2" stdDeviation="3" flood-opacity="0.15" />
    </filter>
  </defs>
  <rect width="200" height="200" fill="url(#grad_capsule_jpg)" rx="16" />
  <g filter="url(#shadow_capsule_jpg)">
  
  <rect x="50" y="65" width="100" height="70" rx="35" fill="#dc2626" />
  <rect x="50" y="65" width="50" height="70" rx="35" fill="#991b1b" />
  <line x1="100" y1="65" x2="100" y2="135" stroke="white" stroke-width="0.5" opacity="0.3" />
  <ellipse cx="75" cy="100" rx="3" ry="2" fill="white" opacity="0.3" />
  <ellipse cx="125" cy="100" rx="3" ry="2" fill="white" opacity="0.3" />
  </g>
</svg>