  </defs>
  <rect width="200" height="200" fill="url(#grad_injection_jpg)" rx="16" />
  <g filter="url(#shadow_injection_jpg)">
  
  <rect x="95" y="25" width="10" height="110" rx="2" fill="#ddd" />
  <rect x="95" y="25" width="10" height="40" rx="2" fill="#0891b2" opacity="0.3" />
  <rect x="85" y="25" width="30" height="15" rx="3" fill="#0e7490" />
  <rect x="97" y="135" width="6" height="20" rx="1" fill="#999" />
