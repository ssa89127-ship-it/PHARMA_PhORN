generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PATIENT
  DOCTOR
  PHARMACY
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentType {
  VIDEO
  CHAT
  IN_PERSON
}

enum MedicineForm {
  TABLET
  CAPSULE
  SYRUP
  CREAM
  INJECTION
  DROPS
  INHALER
  SPRAY
  OINTMENT
  SOLUTION
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id              String    @id @default(cuid())
  name            String?
  email           String?   @unique
  emailVerified   DateTime?
  phone           String?
  image           String?
  passwordHash    String?
  role            UserRole  @default(PATIENT)
  dateOfBirth     DateTime?
  bloodType       String?
  allergies       String[]
  chronicConditions String[]

  isEmailVerified Boolean @default(false)
  isPhoneVerified Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  accounts       Account[]
  sessions       Session[]
  addresses      Address[]
  paymentMethods PaymentMethod[]
  orders         Order[]
  appointments   Appointment[]
  medicalRecords MedicalRecord[]
  reviews        Review[]
  notifications  Notification[]
  loyaltyPoints  LoyaltyPoints?
}

model Pharmacy {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  description    String   @db.Text
  logo           String?
  coverImage     String?
  address        String
  city           String
  state          String
  zipCode        String
  phone          String
  email          String?
  website        String?
  latitude       Float
  longitude      Float
  rating         Float    @default(0)
  reviewCount    Int      @default(0)
  isOpen         Boolean  @default(true)
  isVerified     Boolean  @default(false)
  is24hours      Boolean  @default(false)
  offersDelivery Boolean  @default(true)
  freeDelivery   Boolean  @default(false)
  deliveryFee    Float    @default(0)
  deliveryTime   String?
  minimumOrder   Float    @default(0)
  workingHours   Json?
  userId         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user        User?          @relation(fields: [userId], references: [id])
  medicines   PharmacyMedicine[]
  orders      Order[]
  employees   PharmacyEmployee[]
}

model PharmacyEmployee {
  id         String   @id @default(cuid())
  pharmacyId String
  userId     String
  role       String   @default("EMPLOYEE")
  createdAt  DateTime @default(now())

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pharmacyId, userId])
}

model Category {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  description   String?  @db.Text
  image         String?
  icon          String?
  medicineCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  medicines Medicine[]
}

model Medicine {
  id                  String       @id @default(cuid())
  name                String
  slug                String       @unique
  genericName         String?
  description         String       @db.Text
  image               String?
  manufacturer        String?
  categoryId          String?
  category            String?
  dosage              String?
  form                MedicineForm @default(TABLET)
  strength            String?
  prescriptionRequired Boolean     @default(false)
  unitPrice           Float
  basePrice           Float?
  discountedPrice     Float?
  discount            Int?
  stockQuantity       Int          @default(0)
  isAvailable         Boolean      @default(true)
  sideEffects         String[]
  alternatives        String[]
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  categoryRel Category?          @relation(fields: [categoryId], references: [id])
  pharmacies  PharmacyMedicine[]
  orderItems  OrderItem[]
  reviews     Review[]
}

model PharmacyMedicine {
  pharmacyId String
  medicineId String
  price      Float
  stock      Int     @default(0)
  isAvailable Boolean @default(true)

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@id([pharmacyId, medicineId])
}

model Doctor {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  photo             String?
  specialty         String
  experience        Int
  education         String?
  languages         String[]
  rating            Float    @default(0)
  reviewCount       Int      @default(0)
  consultationFee   Float    @default(0)
  isAvailableToday  Boolean  @default(true)
  availableForVideo Boolean  @default(true)
  availableForChat  Boolean  @default(true)
  availableForInPerson Boolean @default(true)
  bio               String?  @db.Text
  qualifications    String[]
  awards            String[]
  userId            String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user         User?         @relation(fields: [userId], references: [id])
  appointments Appointment[]
  timeSlots    TimeSlot[]
  reviews      Review[]
}

model TimeSlot {
  id        String          @id @default(cuid())
  doctorId  String
  date      DateTime
  startTime String
  endTime   String
  isBooked  Boolean         @default(false)
  type      AppointmentType @default(VIDEO)

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
}

model Order {
  id               String       @id @default(cuid())
  userId           String
  pharmacyId       String
  status           OrderStatus  @default(PENDING)
  total            Float
  subtotal         Float
  deliveryFee      Float        @default(0)
  discount         Float        @default(0)
  tax              Float        @default(0)
  deliveryAddress  Json?
  paymentMethod    String?
  paymentStatus    PaymentStatus @default(PENDING)
  estimatedDelivery DateTime?
  deliveredAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  user     User        @relation(fields: [userId], references: [id])
  pharmacy Pharmacy    @relation(fields: [pharmacyId], references: [id])
  items    OrderItem[]
  tracking TrackingUpdate[]
}

model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  medicineId      String
  medicineName    String
  medicineImage   String?
  dosage          String?
  quantity        Int
  unitPrice       Float
  totalPrice      Float
  prescriptionRequired Boolean @default(false)
  prescriptionUrl String?

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  medicine Medicine @relation(fields: [medicineId], references: [id])
}

model TrackingUpdate {
  id          String   @id @default(cuid())
  orderId     String
  status      String
  location    String?
  timestamp   DateTime @default(now())
  description String   @db.Text

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Appointment {
  id            String            @id @default(cuid())
  doctorId      String
  userId        String
  date          DateTime
  startTime     String
  endTime       String
  type          AppointmentType   @default(VIDEO)
  status        AppointmentStatus @default(SCHEDULED)
  reason        String            @db.Text
  notes         String?           @db.Text
  fee           Float
  paymentStatus PaymentStatus     @default(PENDING)
  meetLink      String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  doctor Doctor @relation(fields: [doctorId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  label     String?
  fullName  String
  phone     String
  street    String
  city      String
  state     String
  zipCode   String
  isDefault Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PaymentMethod {
  id         String  @id @default(cuid())
  userId     String
  type       String
  lastFour   String
  expiryDate String
  isDefault  Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MedicalRecord {
  id           String   @id @default(cuid())
  userId       String
  title        String
  description  String   @db.Text
  fileUrl      String?
  type         String
  date         DateTime
  doctorName   String?
  hospitalName String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String   @db.Text
  type      String   @default("system")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Review {
  id         String   @id @default(cuid())
  userId     String
  medicineId String?
  doctorId   String?
  pharmacyId String?
  rating     Int
  comment    String   @db.Text
  createdAt  DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id])
  medicine Medicine? @relation(fields: [medicineId], references: [id])
  doctor   Doctor?   @relation(fields: [doctorId], references: [id])
  pharmacy Pharmacy? @relation(fields: [pharmacyId], references: [id])
}

model Coupon {
  id            String   @id @default(cuid())
  code          String   @unique
  description   String   @db.Text
  discountType  String
  discountValue Float
  minimumOrder  Float    @default(0)
  maxUses       Int      @default(100)
  currentUses   Int      @default(0)
  expiresAt     DateTime
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
}

model LoyaltyPoints {
  id              String @id @default(cuid())
  userId          String @unique
  total           Int    @default(0)
  earned          Int    @default(0)
  redeemed        Int    @default(0)
  tier            String @default("bronze")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items  CartItem[]
}

model CartItem {
  id              String  @id @default(cuid())
  cartId          String
  medicineId      String
  medicineName    String
  medicineImage   String?
  dosage          String?
  pharmacyId      String
  pharmacyName    String
  unitPrice       Float
  quantity        Int
  prescriptionRequired Boolean @default(false)
  prescriptionUrl String?

  cart     Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  medicine Medicine @relation(fields: [medicineId], references: [id])
}
